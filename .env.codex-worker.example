# 이 파일은 로컬 Codex 워커 전용입니다. 앱/Discord/Supabase/배포 secret을 넣지 마세요.
# macOS에서는 미설정 시 `albion-guildmanager-codex-worker` Keychain 항목을 사용합니다.
CODEX_WORKER_SECRET=
CODEX_WORKER_BASE_URL=https://albion-guildmanager.com
CODEX_WORKER_REPO_PATH=/absolute/path/to/albion-zvz

# 선택. 미설정 시 저장소와 같은 부모 폴더의 숨김 디렉터리를 사용합니다.
CODEX_WORKER_WORKTREE_ROOT=
CODEX_WORKER_TIMEOUT_MS=1800000
CODEX_WORKER_ID=
