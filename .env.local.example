# 권장 로컬 셋업: 값을 직접 복사하지 말고 `npm run dev:setup` 실행.
# 아래 Supabase/app/Test Auth 값은 실행 중인 로컬 Supabase 기준으로 자동 갱신된다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_key

# 실제 Discord OAuth/봇 검증 때만 필요. Test Auth 개발에서는 비워도 된다.
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_CLIENT_SECRET=your_discord_oauth_secret
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_PUBLIC_KEY=your_discord_application_public_key

COOKIE_SECRET=random_32_char_string_here
COOKIE_SECURE=false
APP_URL=http://localhost:3000
TENANT_ROOT_DOMAIN=localhost
CRON_SECRET=random_cron_bearer_token

# 선택: Google Search Console SEO 리포트 수집.
# 미설정이면 /api/cron/search-console-sync 는 실패하지 않고 skipped 로 기록한다.
# Domain property 가 없으면 URL-prefix property 인 https://albion-guildmanager.com/ 를 사용한다.
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://albion-guildmanager.com/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# 선택: Search Console URL-prefix HTML tag 인증용. 토큰만 넣거나 meta 태그 전체를 붙여넣어도 된다.
GOOGLE_SITE_VERIFICATION=

# 선택: 로컬/프리뷰 자동화에서 Discord OAuth 없이 앱 세션을 발급할 때만 사용.
# NODE_ENV=production 또는 Vercel production 에서는 값이 있어도 항상 404.
ENABLE_TEST_AUTH=false
TEST_AUTH_SECRET=random_16_plus_char_test_auth_secret

# 운영자 전용. SUPER_ADMIN_PATH 는 비워두면 super-admin 라우트가 잠긴다.
SUPER_ADMIN_DISCORD_IDS=
SUPER_ADMIN_PATH=

# 레거시 세션 fallback 용. 신규 tenant 라우팅/cron 은 DB 의 tenants/app_settings 를 사용.
DISCORD_GUILD_ID=

# 선택: Tailscale/LAN 등 localhost 외 origin 에서 Server Actions 를 호출할 때만.
ALLOWED_ORIGINS=

# 선택: safe-db-push.sh / backup-db.sh 가 Supabase CLI 백업을 만들 때 사용.
SUPABASE_ACCESS_TOKEN=

# 선택: super-admin tenant 상세에서 서브도메인 링크를 절대 URL 로 표시할 때 사용.
NEXT_PUBLIC_TENANT_BASE_URL=

# Phase 2 통합 테스트 (선택). `npm run test:integration` 실행 시 필요.
# 절대 prod URL 을 가리키지 말 것 — 테스트 길드 생성 + CASCADE 로 손실 위험.
# 로컬: `supabase start` 후 `supabase status` 의 service_role 값 사용.
TEST_SUPABASE_URL=http://127.0.0.1:54321
TEST_SUPABASE_SERVICE_KEY=eyJ...local_service_role_key
# 전용 remote test project 를 쓸 때만 1. production Supabase URL/key 재사용은 차단됨.
ALLOW_REMOTE_TEST_SUPABASE=0

# Sentry (선택). 비워두면 SDK 가 no-op. prod 에서만 채우는 걸 권장.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# 빌드 시 source map 업로드용 (없으면 skip, 에러는 minified 스택으로 표시).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
