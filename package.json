{
  "name": "albion-guildmanager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "prebuild": "node scripts/build-items.mjs && node scripts/build-item-spells.mjs && node scripts/build-spell-cooldowns.mjs",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=30000",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:required": "node scripts/test-environment.mjs && vitest run --config vitest.integration.config.ts --passWithNoTests=false",
    "perf:smoke": "node scripts/perf-smoke.mjs",
    "smoke:public-cache": "node scripts/perf-smoke.mjs --base-url https://albion-guildmanager.com --paths /features,/pricing,/faq,/docs --samples 3 --title \"공개 마케팅 CDN 캐시 검증\" --expect-cdn-cache-control \"public, s-maxage=3600, stale-while-revalidate=86400\"",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "smoke:create-test-auth": "node scripts/create-test-auth-storage-state.mjs",
    "smoke:slot-workspace": "node scripts/slot-workspace-smoke.mjs",
    "smoke:browser-matrix": "node scripts/browser-matrix-smoke.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "update:albion-data": "AO_DATA_REFRESH=1 node scripts/build-items.mjs && AO_DATA_REFRESH=1 node scripts/build-item-spells.mjs && AO_DATA_REFRESH=1 node scripts/build-spell-cooldowns.mjs",
    "check:migrations:remote": "scripts/check-supabase-migration-drift.sh",
    "register:discord-support": "node --env-file=.env.local scripts/register-discord-support-commands.mjs"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.12",
    "@sentry/nextjs": "^10.68.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.110.8",
    "@swc/helpers": "0.5.15",
    "@types/mdx": "^2.0.13",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^5.5.7",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/config": "^0.5.5",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "@swc/helpers": "0.5.15",
    "brace-expansion@1": "1.1.18",
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  }
}
