# Vercel은 .gitignore도 적용하지만, 명시적으로 제외해서 업로드 페이로드를 줄임.
# .next 캐시(>250MB)와 node_modules는 Vercel이 빌드시 새로 만들기 때문에
# 로컬에서 올릴 필요가 없음.

# 빌드 산출물 / 캐시
.next/
node_modules/
.cache/
coverage/
*.tsbuildinfo
next-env.d.ts

# 환경 / 시크릿 (이중 안전망)
.env
.env.*
!.env.local.example
.vercel

# OS / 에디터
.DS_Store
*.pem

# 디버그 로그
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# 문서 / git 메타 (런타임 불필요)
README.md
AGENTS.md
CLAUDE.md
.git/
.gitignore
.github/

# Supabase 마이그레이션 (DB 측에서만 적용, 런타임 불필요)
supabase/
